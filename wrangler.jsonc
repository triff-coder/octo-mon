{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octo-mon",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "OCTOMON_KV",
      "id": "abba0bf4bd484b2e8c1673e6469b3d90"
    }
  ],
  "vars": {
    "OCTOPUS_PRODUCT_CODE": "AGILE-24-10-01",
    "OCTOPUS_TARIFF_CODE": "E-1R-AGILE-24-10-01-C"
  }
}
